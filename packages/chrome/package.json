{
  "name": "@mr-newtabby/chrome",
  "version": "1.14.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Chrome new-tab extension that floats your bookmarks toolbar at the top with a rotating Unsplash wallpaper.",
  "scripts": {
    "build": "node build.ts",
    "dev": "node build.ts && (node build.ts --watch & web-ext run --source-dir=dist --target=chromium)",
    "package": "web-ext build"
  },
  "dependencies": {
    "@mr-newtabby/shared": "*"
  },
  "devDependencies": {
    "web-ext": "^10.1.0"
  }
}
