{
  "name": "mr-newtabby-monorepo",
  "version": "1.16.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:firefox": "npm run dev -w @mr-newtabby/firefox",
    "dev:chrome": "npm run dev -w @mr-newtabby/chrome",
    "dev:site": "npx http-server ./site --port 8080",
    "build": "npm run build -w @mr-newtabby/firefox && npm run build -w @mr-newtabby/chrome",
    "build:firefox": "npm run build -w @mr-newtabby/firefox",
    "build:chrome": "npm run build -w @mr-newtabby/chrome",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json",
    "sync-versions": "node scripts/sync-versions.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
